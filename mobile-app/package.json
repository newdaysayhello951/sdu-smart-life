{
  "name": "sdu-smart-life-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174 --strictPort",
    "android:sync": "npm run build && cap sync android",
    "android:sync:debug": "vue-tsc --noEmit && vite build --mode debug && cap sync android",
    "android:open": "cap open android",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "axios": "^1.12.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
